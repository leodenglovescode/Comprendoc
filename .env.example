# 32 random bytes encoded as base64. Never store this in the database.
COMPRENDOC_MASTER_KEY=replace_with_32_byte_base64_key
# Long random token required to open and change provider settings.
COMPRENDOC_ADMIN_TOKEN=replace_with_long_random_admin_token
# Set this only when publishing a read-only public showcase.
# COMPRENDOC_MODE=demo
